# Home Assistant base URL (no trailing slash)
HA_URL=https://homeassistant.example.com
# Long-lived access token (Profile > Security). Server-side only.
HA_TOKEN=
# Password for the web app login gate
APP_PASSWORD=change-me
# Random secret used to sign the session cookie (openssl rand -hex 32)
SESSION_SECRET=
# Optional: set to 1 to block all write calls to Home Assistant (safe testing)
HA_READ_ONLY=0
# Port published by docker compose
PORT=3000
